# Copy this file to .env and fill in your credentials.
# Never commit the .env file to version control.

# OpenAI API key (for GPT-4o, GPT-4o-mini, o1-mini, etc.)
OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API key (for Gemini models via google-generativeai)
GOOGLE_API_KEY=AIza...

# Google Cloud credentials (for Vertex AI — only needed for Llama models)
# Point this to your GCP service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Paths to Project Gutenberg source data (only needed for extract_stories.py)
DETECTIVE_FICTION_CSV=/path/to/detective-fiction-PG.csv
DETECTIVE_BOOKS_JSON=/path/to/detective-books.json
